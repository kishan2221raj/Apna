{
  "name": "apna-enterprises",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "npm run build"
  },
  "keywords": [],
  "author": "Apna Enterprises",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.apna.enterprises",
    "productName": "Apna Enterprises",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "sign": null,
      "signingHashAlgorithms": null
    },
    "files": [
      "**/*",
      "!dist/*",
      "!database/*.db"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false
  }
}
